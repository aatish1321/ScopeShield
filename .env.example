# Copy to .env and enter secrets locally. Never commit .env.
# Empty secrets intentionally prevent a configured app from starting.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Generate locally: openssl rand -hex 32
OWNER_ACCESS_KEY=
APP_URL=http://localhost:3000
PORT=3000
NODE_ENV=development
